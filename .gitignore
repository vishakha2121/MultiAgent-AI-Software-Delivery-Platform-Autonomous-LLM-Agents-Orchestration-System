# ============================================
# Multi-Agent AI Software Delivery Platform
# .gitignore - Files to ignore from Git
# ============================================

# ──────────────────────────────────────────
# 🔐 ENVIRONMENT VARIABLES (VERY IMPORTANT!)
# ──────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
*.env
backend/.env
frontend/.env
.env.*.local

# ──────────────────────────────────────────
# 🐍 PYTHON
# ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.python-version

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# ──────────────────────────────────────────
# 🗄️ DATABASE (SQLite)
# ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
multi_agent.db
backend/*.db
backend/*.sqlite3
backend/multi_agent.db

# ──────────────────────────────────────────
# 📁 STORAGE - Generated Artifacts
# ──────────────────────────────────────────
backend/storage/*
!backend/storage/.gitkeep
backend/storage/uploads/*
backend/storage/requirements/*
backend/storage/architecture/*
backend/storage/code/*
backend/storage/tests/*
backend/storage/security_reports/*
backend/storage/deployments/*
!backend/storage/**/.gitkeep

# ──────────────────────────────────────────
# 📝 LOGS
# ──────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/
backend/logs/*.log
!backend/logs/.gitkeep

# ──────────────────────────────────────────
# 📦 NODE / REACT / VITE
# ──────────────────────────────────────────
node_modules/
node_modules
/.pnp
.pnp.js
.pnp.cjs

# Production build
/build
/dist
frontend/dist/
frontend/build/

# Testing
/coverage
*.lcov
.nyc_output

# Vite
frontend/.vite/
.vite/
frontend/dist-ssr/

# Misc
.DS_Store
.npm
.yarn
yarn-error.log*
.pnpm-store/

# ──────────────────────────────────────────
# ⚙️ IDE / EDITOR
# ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────
# 🖥️ OS FILES
# ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Windows
*.lnk
*.bak
*.tmp
~$*

# ──────────────────────────────────────────
# 🔒 SECURITY / SECRETS
# ──────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json
api_keys.txt
*.secret

# ──────────────────────────────────────────
# 🐳 DOCKER
# ──────────────────────────────────────────
.dockerignore
docker-compose.override.yml

# ──────────────────────────────────────────
# 📊 MISC
# ──────────────────────────────────────────
*.bak
*.backup
*.old
*.orig
.cache/
tmp/
temp/
*.swp